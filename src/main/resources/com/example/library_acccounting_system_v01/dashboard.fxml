<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="main_form" prefHeight="680.0" prefWidth="1180.0" styleClass="app-root"
            stylesheets="@design.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.library_acccounting_system_v01.DashboardController">

    <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- ===== Barre du haut ===== -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="top-bar">
                <padding><Insets top="6" right="8" bottom="6" left="16"/></padding>
                <Label styleClass="top-title" text="📚  Library Accounting System"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="minimize" mnemonicParsing="false" onAction="#minimize" styleClass="window-btn" text="—"/>
                <Button fx:id="close" mnemonicParsing="false" onAction="#close" styleClass="close-btn" text="✕"/>
            </HBox>
        </top>

        <!-- ===== Menu de gauche ===== -->
        <left>
            <VBox prefWidth="220.0" spacing="8.0" styleClass="nav">
                <padding><Insets top="24" right="14" bottom="18" left="14"/></padding>
                <Label styleClass="nav-hello" text="Welcome,"/>
                <Label fx:id="username_home" styleClass="nav-user" text="admin"/>
                <Region prefHeight="18.0"/>
                <Button fx:id="home_btn" maxWidth="Infinity" mnemonicParsing="false" onAction="#switchForm"
                        styleClass="nav-btn" text="🏠  Dashboard"/>
                <Button fx:id="add_books_btn" maxWidth="Infinity" mnemonicParsing="false" onAction="#switchForm"
                        styleClass="nav-btn" text="📖  Add Books"/>
                <Button fx:id="lent_btn" maxWidth="Infinity" mnemonicParsing="false" onAction="#switchForm"
                        styleClass="nav-btn" text="🛒  Purchase"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="logout" maxWidth="Infinity" mnemonicParsing="false" onAction="#logOut"
                        styleClass="nav-btn" text="⎋  Logout"/>
            </VBox>
        </left>

        <!-- ===== Contenu ===== -->
        <center>
            <StackPane>

                <!-- Accueil -->
                <AnchorPane fx:id="home_form" styleClass="content">
                    <VBox spacing="20.0" AnchorPane.topAnchor="24.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="page-title" text="Dashboard"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="home_date" styleClass="muted" text="--/--/--"/>
                            <Label fx:id="home_time" styleClass="muted" text="--:--:--"/>
                        </HBox>
                        <HBox spacing="20.0">
                            <VBox spacing="6.0" styleClass="card" HBox.hgrow="ALWAYS">
                                <Label styleClass="card-label" text="Available books"/>
                                <Label fx:id="home_availableBooks" styleClass="card-value" text="0"/>
                            </VBox>
                            <VBox spacing="6.0" styleClass="card" HBox.hgrow="ALWAYS">
                                <Label styleClass="card-label" text="Total income"/>
                                <Label fx:id="home_totalIncome" styleClass="card-value" text="€0.0"/>
                            </VBox>
                            <VBox spacing="6.0" styleClass="card" HBox.hgrow="ALWAYS">
                                <Label styleClass="card-label" text="Users"/>
                                <Label fx:id="home_availableUsers" styleClass="card-value" text="0"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </AnchorPane>

                <!-- Ajout de livres -->
                <AnchorPane fx:id="addBook_form" styleClass="content" visible="false">
                    <HBox spacing="20.0" AnchorPane.topAnchor="24.0" AnchorPane.bottomAnchor="24.0"
                          AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0">

                        <VBox prefWidth="290.0" spacing="10.0" styleClass="card">
                            <Label styleClass="section-title" text="Book details"/>
                            <Label styleClass="field-label" text="Book ID"/>
                            <TextField fx:id="add_bookID" promptText="e.g. 5" styleClass="field"/>
                            <Label styleClass="field-label" text="Title"/>
                            <TextField fx:id="add_bookName" styleClass="field"/>
                            <Label styleClass="field-label" text="Author"/>
                            <TextField fx:id="add_bookAuthor" styleClass="field"/>
                            <Label styleClass="field-label" text="Category"/>
                            <ComboBox fx:id="add_bookCategory" maxWidth="Infinity" promptText="Choose..." styleClass="field"/>
                            <Label styleClass="field-label" text="Price (€)"/>
                            <TextField fx:id="add_bookPrice" promptText="e.g. 12.50" styleClass="field"/>
                            <Region prefHeight="6.0"/>
                            <GridPane hgap="8.0" vgap="8.0">
                                <Button fx:id="addBookAdd" maxWidth="Infinity" mnemonicParsing="false" onAction="#addBooksAdd"
                                        styleClass="primary-btn" text="Add" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Button fx:id="addBookUpdate" maxWidth="Infinity" mnemonicParsing="false" onAction="#addBookUpdate"
                                        styleClass="secondary-btn" text="Update" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Button fx:id="addBookClear" maxWidth="Infinity" mnemonicParsing="false" onAction="#addBooksClear"
                                        styleClass="secondary-btn" text="Clear" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Button fx:id="addBookDelete" maxWidth="Infinity" mnemonicParsing="false" onAction="#addBookDelete"
                                        styleClass="danger-btn" text="Delete" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            </GridPane>
                            <Button fx:id="addBookReport" maxWidth="Infinity" mnemonicParsing="false" onAction="#exportToExcel"
                                    styleClass="secondary-btn" text="Export books to Excel"/>
                        </VBox>

                        <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                            <TextField fx:id="addBook_search" onKeyTyped="#addBookSearch" promptText="🔍  Search a book..."
                                       styleClass="field"/>
                            <TableView fx:id="addBook_tableView" onMouseClicked="#addBookSelect" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="addBook_col_id" prefWidth="70.0" text="Book ID"/>
                                    <TableColumn fx:id="addBook_col_name" prefWidth="180.0" text="Title"/>
                                    <TableColumn fx:id="addBook_col_category" prefWidth="100.0" text="Category"/>
                                    <TableColumn fx:id="addBook_col_author" prefWidth="160.0" text="Author"/>
                                    <TableColumn fx:id="addBook_col_price" prefWidth="80.0" text="Price"/>
                                    <TableColumn fx:id="addBook_col_date" prefWidth="90.0" text="Date"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>
                    </HBox>
                </AnchorPane>

                <!-- Achat -->
                <AnchorPane fx:id="purchase_form" styleClass="content" visible="false">
                    <HBox spacing="20.0" AnchorPane.topAnchor="24.0" AnchorPane.bottomAnchor="24.0"
                          AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0">

                        <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label styleClass="section-title" text="Current order"/>
                            <TableView fx:id="purchase_tableView" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="purchase_col_id" prefWidth="70.0" text="Book ID"/>
                                    <TableColumn fx:id="purchase_col_bookName" prefWidth="170.0" text="Title"/>
                                    <TableColumn fx:id="purchase_col_category" prefWidth="90.0" text="Category"/>
                                    <TableColumn fx:id="purchase_col_author" prefWidth="140.0" text="Author"/>
                                    <TableColumn fx:id="purchase_col_quantity" prefWidth="70.0" text="Qty"/>
                                    <TableColumn fx:id="purchase_col_publish_date" prefWidth="100.0" text="Date"/>
                                    <TableColumn fx:id="purchase_col_price" prefWidth="80.0" text="Price"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                            <Button fx:id="salest_excel_btn" mnemonicParsing="false" onAction="#exportSalesToExcel"
                                    styleClass="secondary-btn" text="Export sales to Excel"/>
                        </VBox>

                        <VBox prefWidth="280.0" spacing="10.0" styleClass="card">
                            <Label styleClass="section-title" text="Add to order"/>
                            <Label styleClass="field-label" text="Book ID"/>
                            <ComboBox fx:id="purchae_bookId" maxWidth="Infinity" onAction="#purchaseBookName"
                                      promptText="Choose..." styleClass="field"/>
                            <Label styleClass="field-label" text="Title"/>
                            <ComboBox fx:id="purchase_bookName" maxWidth="Infinity" promptText="Choose..." styleClass="field"/>
                            <Label styleClass="field-label" text="Quantity"/>
                            <Spinner fx:id="purchase_quantity" maxWidth="Infinity" onMouseClicked="#purchaseQty"/>
                            <Button fx:id="purchase_btn_add" maxWidth="Infinity" mnemonicParsing="false" onAction="#purchaseAdd"
                                    styleClass="primary-btn" text="Add"/>

                            <Region prefHeight="10.0"/>
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="field-label" text="Total"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="purchase_total" styleClass="total-value" text="€0.0"/>
                            </HBox>
                            <Label styleClass="field-label" text="Amount received (press Enter)"/>
                            <TextField fx:id="purchase_amount" onAction="#purchaseAmount" promptText="e.g. 50"
                                       styleClass="field"/>
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="field-label" text="Change"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="purchase_balance" styleClass="total-value" text="€0.0"/>
                            </HBox>
                            <Button fx:id="purchase_btn_pay" maxWidth="Infinity" mnemonicParsing="false" onAction="#purchasePay"
                                    styleClass="primary-btn" text="Pay"/>
                        </VBox>
                    </HBox>
                </AnchorPane>

            </StackPane>
        </center>
    </BorderPane>
</AnchorPane>
