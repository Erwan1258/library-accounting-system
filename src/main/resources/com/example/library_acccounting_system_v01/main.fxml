<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<!-- Écran de connexion -->
<AnchorPane fx:id="main_form" prefHeight="420.0" prefWidth="680.0" styleClass="login-root"
            stylesheets="@design.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.library_acccounting_system_v01.MainController">

    <!-- Bandeau gauche -->
    <VBox alignment="CENTER" prefWidth="300.0" spacing="12.0" styleClass="login-side"
          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
        <Label styleClass="login-logo" text="📚"/>
        <Label styleClass="login-brand" text="Library"/>
        <Label styleClass="login-brand-sub" text="Accounting System"/>
    </VBox>

    <!-- Formulaire -->
    <VBox alignment="CENTER_LEFT" spacing="14.0"
          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="0.0">
        <padding><Insets top="40" right="50" bottom="40" left="50"/></padding>
        <Label styleClass="login-title" text="Welcome back"/>
        <Label styleClass="muted" text="Sign in to your admin account"/>
        <TextField fx:id="username" promptText="Username" styleClass="field" onAction="#adminLogin"/>
        <PasswordField fx:id="password" promptText="Password" styleClass="field" onAction="#adminLogin"/>
        <Button fx:id="loginBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#adminLogin"
                styleClass="primary-btn" text="Login"/>
    </VBox>

    <Button fx:id="close" mnemonicParsing="false" onAction="#close" styleClass="close-btn" text="✕"
            AnchorPane.topAnchor="8.0" AnchorPane.rightAnchor="8.0"/>
</AnchorPane>
